# Microsoft Foundry / Azure OpenAI (used with --analyst foundry, --extractor foundry, --ocr foundry)
AZURE_OPENAI_ENDPOINT=https://<your-resource>.openai.azure.com
AZURE_OPENAI_DEPLOYMENT=<deployment name from Foundry>
# Leave the key empty to sign in with Microsoft Entra ID (az login) instead - recommended for firms.
AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_API_VERSION=2024-10-21
# AZURE_OPENAI_BASE_URL=   # alternative "v1" style endpoint: https://<resource>.openai.azure.com/openai/v1/
